  "opportunities": [
   {
    "id": "mcp-unpinned",
    "kind": "tighten",
    "title": "3 MCP servers run an unpinned package",
    "detail": "playwright, postgres, notes (Claude Desktop) fetch whatever version is newest each launch, so a bad or hijacked release runs with your tools' access the moment it ships. Pin at least the major version.",
    "learnUrl": "https://staas.fund/mcp/"
   },
   {
    "id": "mcp-env-secrets",
    "kind": "tighten",
    "title": "2 MCP servers are handed credentials",
    "detail": "postgres, figma receive environment variables, usually API keys, stored in plain text in your Claude config. Know which servers hold which keys, and scope those keys as narrowly as the vendor allows.",
    "learnUrl": "https://staas.fund/mcp/"
   },
   {
    "id": "mcp-remote",
    "kind": "learn",
    "title": "1 remote MCP server",
    "detail": "github runs on someone else's machine: what you send there leaves this computer. Worth checking the trust rating before pointing it at client work.",
    "learnUrl": "https://staas.fund/mcp/"
   },
   {
    "id": "agents-model-unset",
    "kind": "learn",
    "title": "1 agent inherits the session model",
    "detail": "An agent with no model runs on whatever you are using, often the most expensive one. Naming a lighter model for search and summarising agents cuts spend with no quality loss.",
    "learnUrl": "https://staas.fund/classroom/"
   }
  ]
