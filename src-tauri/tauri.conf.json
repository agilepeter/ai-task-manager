{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Task Manager",
  "version": "0.1.2",
  "identifier": "fund.staas.aitaskmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI Task Manager",
        "dragDropEnabled": false,
        "width": 380,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/agilepeter/ai-task-manager/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDREZGOTYzODVDQTgxMDEKUldRQmdjcUZZL25mYkVtKzlaWEVXTFgxWWI3U1NCR0MzSG5yNFE0NGFVRE5TS3FGeVFLbk9sYVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "StaaS Fund",
    "copyright": "© 2026 StaaS Fund and the Pane, OpenUsage and CodexBar authors (MIT)",
    "shortDescription": "AI usage limits in your system tray",
    "longDescription": "AI Task Manager shows how much of your session and weekly limits each AI tool has left, from the menu bar on macOS and the system tray on Windows.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
